+// Controller Pak emulation. Each controller port gets a 32 KB image in the standard .mpk layout (the same raw
+// format N64 emulators use), stored next to the game's other saves as controller_pak_<n>.mpk. The libultra
+// file-system calls (osPfs*) are implemented directly on that image, so no SI/pak protocol is emulated.
+//
+// Layout (256-byte pages): page 0 = ID area, page 1 = inode table, page 2 = inode table copy,
+// pages 3-4 = 16 note (directory) entries, pages 5-127 = file data. Inode entries are 16-bit:
+// 0x0001 ends a file, 0x0003 marks a free page, otherwise the next page of the file.
+
+namespace {
+    constexpr int pak_size = 0x8000;
+    constexpr int page_size = 0x100;
+    constexpr int num_pages = 128;
+    constexpr int first_data_page = 5;
+    constexpr int inode_page = 1;
+    constexpr int inode_backup_page = 2;
+    constexpr int dir_page = 3;
+    constexpr int dir_entries = 16;
+    constexpr int dir_entry_size = 32;
+
+    constexpr uint16_t inode_last = 0x0001;
+    constexpr uint16_t inode_free = 0x0003;
+
+    constexpr s32 PFS_ERR_NOPACK = 1;
+    constexpr s32 PFS_ERR_INVALID = 5;
+    constexpr s32 PFS_DATA_FULL = 7;
+    constexpr s32 PFS_DIR_FULL = 8;
+    constexpr s32 PFS_ERR_EXIST = 9;
+
+    constexpr int max_paks = 4;
+
+    struct Pak {
+        bool loaded = false;
+        std::array<uint8_t, pak_size> data{};
+    };
+
+    std::array<Pak, max_paks> paks;
+    std::mutex pak_mutex;
+
+    uint16_t get16(const uint8_t* p) { return uint16_t((p[0] << 8) | p[1]); }
+    uint32_t get32(const uint8_t* p) { return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3]; }
+    void put16(uint8_t* p, uint16_t v) { p[0] = uint8_t(v >> 8); p[1] = uint8_t(v); }
+    void put32(uint8_t* p, uint32_t v) { p[0] = uint8_t(v >> 24); p[1] = uint8_t(v >> 16); p[2] = uint8_t(v >> 8); p[3] = uint8_t(v); }
+
+    std::filesystem::path pak_path(int channel) {
+        std::filesystem::path folder = ultramodern::get_save_file_path().parent_path();
+        return folder / ("controller_pak_" + std::to_string(channel + 1) + ".mpk");
+    }
+
+    uint8_t* inode(Pak& pak, int page) { return &pak.data[inode_page * page_size + page * 2]; }
+    uint8_t* dir_entry(Pak& pak, int file_no) { return &pak.data[dir_page * page_size + file_no * dir_entry_size]; }
+
+    // Inode checksum: low byte of the sum of the data-page entries, kept in byte 1 of the table.
+    void finish_inode_table(Pak& pak) {
+        uint8_t* table = &pak.data[inode_page * page_size];
+        uint32_t sum = 0;
+        for (int i = first_data_page * 2; i < page_size; i++) {
+            sum += table[i];
+        }
+        table[1] = uint8_t(sum);
+        memcpy(&pak.data[inode_backup_page * page_size], table, page_size);
+    }
+
+    void format(Pak& pak) {
+        pak.data.fill(0);
+        // ID block (repeated at 0x20, 0x60, 0x80 and 0xC0): serial data, device id 1, one bank, then the
+        // checksum and inverted checksum over its first 28 bytes.
+        uint8_t id[32]{};
+        const uint8_t serial[24] = { 0xFF, 0xFF, 0xFF, 0xFF, 0x05, 0x1A, 0x5F, 0x13, 0x00, 0x00, 0x00, 0x00,
+                                     0x00, 0x00, 0x00, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF };
+        memcpy(id, serial, sizeof(serial));
+        put16(&id[0x18], 0x0001);
+        id[0x1A] = 0x01;
+        id[0x1B] = 0x00;
+        uint16_t sum = 0, inv = 0;
