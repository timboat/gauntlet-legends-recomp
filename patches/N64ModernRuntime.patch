+// std::filesystem::copy_file leaves an empty destination on the Vita's newlib, so copy through streams instead.
+static bool copy_file_contents(const std::filesystem::path& from, const std::filesystem::path& to) {
+    std::ifstream in{from, std::ios_base::binary};
+    if (!in.good()) {
+        return false;
+    }
+    std::ofstream out{to, std::ios_base::binary | std::ios_base::trunc};
+    if (!out.good()) {
+        return false;
+    }
+    char buffer[4096];
+    while (in.read(buffer, sizeof(buffer)) || in.gcount() > 0) {
+        if (!out.write(buffer, in.gcount())) {
+            return false;
+        }
+    }
+    out.flush();
+    return !in.bad() && out.good();
+}
