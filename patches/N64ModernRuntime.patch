+            std::filesystem::path path = pak_path(channel);
+            bool read = false;
+            for (const char* suffix : {"", ".bak", ".temp"}) {
+                std::filesystem::path candidate = path;
+                candidate += suffix;
+                std::ifstream file{candidate, std::ios_base::binary};
+                if (file.good() && file.read(reinterpret_cast<char*>(pak.data.data()), pak_size)) {
+                    read = true;
+                    break;
+                }
+            }
+            if (!read) {
+                format(pak);
+            }
+        }
+        return pak;
+    }
+
+    void store(int channel) {
+        std::filesystem::path path = pak_path(channel);
+        std::error_code ec;
+        std::filesystem::create_directories(path.parent_path(), ec);
+        bool ok = false;
+        {
+            std::ofstream file = recomp::open_output_file_with_backup(path, std::ios_base::binary);
+            if (file.good()) {
+                file.write(reinterpret_cast<const char*>(paks[channel].data.data()), pak_size);
+                ok = file.good();
+            }
+        }
+        if (!ok || !recomp::finalize_output_file_with_backup(path)) {
+            ultramodern::error_handling::message_box("Failed to write the Controller Pak save file. Check your file permissions.");
+        }
+    }
+
+    int pfs_channel(uint8_t* rdram, gpr pfs) {
+        int channel = MEM_W(0x08, pfs);
+        return (channel >= 0 && channel < max_paks) ? channel : -1;
+    }
+
+    bool entry_used(const uint8_t* e) { return get32(&e[0]) != 0 || get16(&e[4]) != 0; }
+
+    int count_pages(Pak& pak, int start) {
+        int pages = 0;
+        int page = start;
+        while (page >= first_data_page && page < num_pages && pages < num_pages) {
+            pages++;
+            uint16_t next = get16(inode(pak, page));
+            if (next == inode_last) {
+                break;
+            }
+            page = next & 0xFF;
+        }
+        return pages;
+    }
+
+    int free_pages(Pak& pak) {
+        int count = 0;
+        for (int page = first_data_page; page < num_pages; page++) {
+            count += get16(inode(pak, page)) == inode_free;
+        }
+        return count;
+    }
+
+    int find_file(uint8_t* rdram, Pak& pak, uint16_t company, uint32_t game, gpr game_name, gpr ext_name) {
+        for (int i = 0; i < dir_entries; i++) {
+            const uint8_t* e = dir_entry(pak, i);
+            if (get32(&e[0]) != game || get16(&e[4]) != company) {
+                continue;
+            }
+            bool match = true;
+            for (int j = 0; j < 16 && match; j++) {
+                match = e[16 + j] == MEM_BU(j, game_name);
+            }
+            for (int j = 0; j < 4 && match; j++) {
+                match = e[12 + j] == MEM_BU(j, ext_name);
+            }
+            if (match) {
+                return i;
+            }
+        }
+        return -1;
+    }
 
+    void free_chain(Pak& pak, int start) {
+        int page = start;
+        for (int n = 0; n < num_pages && page >= first_data_page && page < num_pages; n++) {
+            uint16_t next = get16(inode(pak, page));
+            put16(inode(pak, page), inode_free);
+            if (next == inode_last || next == inode_free) {
+                break;
+            }
+            page = next & 0xFF;
+        }
+    }
+}
