+//---------------------------------------------------------
+// Semaphore (PS Vita kernel semaphore). pthread-embedded's POSIX sem_wait can return
+// without the semaphore having been signalled, which let two scheduler-owned threads run at once.
+//---------------------------------------------------------
+class Semaphore
+{
+private:
+	SceUID m_sema;
+
+	Semaphore(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+	Semaphore& operator=(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+
+public:
+	Semaphore(int initialCount = 0)
+	{
+		assert(initialCount >= 0);
+		m_sema = sceKernelCreateSema("mc_sema", 0, initialCount, 0x7FFFFFFF, nullptr);
+		assert(m_sema >= 0);
+	}
+
+	~Semaphore()
+	{
+		sceKernelDeleteSema(m_sema);
+	}
+
+	bool wait()
+	{
+		return sceKernelWaitSema(m_sema, 1, nullptr) == 0;
+	}
+
+	bool try_wait()
+	{
+		return sceKernelPollSema(m_sema, 1) == 0;
+	}
+
+	bool timed_wait(std::uint64_t usecs)
+	{
+		SceUInt timeout = usecs > 0xFFFFFFFFull ? 0xFFFFFFFFu : (SceUInt)usecs;
+		return sceKernelWaitSema(m_sema, 1, &timeout) == 0;
+	}
+
+	void signal()
+	{
+		sceKernelSignalSema(m_sema, 1);
+	}
+
+	void signal(int count)
+	{
+		if (count > 0) sceKernelSignalSema(m_sema, count);
+	}
+};
 #elif defined(__unix__)
 //---------------------------------------------------------
 // Semaphore (POSIX, Linux)
